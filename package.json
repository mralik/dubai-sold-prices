{
  "name": "dubai-sold-prices",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ask what Dubai homes actually sold for, in plain English. Built on Dubai Land Department open data.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/dev.ts",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "typecheck": "tsc --noEmit",
    "data:inspect": "tsx data/inspect.ts 'data/raw/transactions_*.csv'",
    "data:import": "tsx data/import.ts 'data/raw/transactions_*.csv' data/processed/sales.parquet",
    "data:update": "tsx data/update.ts && npm run data:validate && npm test",
    "data:validate": "DATA_MODE=dld tsx data/validate.ts",
    "cf:typecheck": "tsc --noEmit -p worker",
    "cf:prepare": "DATA_MODE=dld tsx data/cfPrepare.ts",
    "cf:build": "vite build && tsx data/cfHeaders.ts && npm run cf:prepare",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "d1:export": "tsx data/d1Export.ts",
    "d1:load:local": "tsx data/d1Load.ts --local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@duckdb/node-api": "^2.0.1-r.1",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "sql.js": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "4.158.0"
  },
  "author": "Ali Kalantari (https://thealik.com)",
  "license": "MIT"
}
