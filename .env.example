# Optional. Without a key, the app uses the free built-in demo reader.
# With a key, questions are read by Claude (this is billed by Anthropic).
ANTHROPIC_API_KEY=

# Safety limit on Claude calls per day for the local server.
DAILY_CLAUDE_CALL_LIMIT=50

# sample keeps the original synthetic demo. dld uses data/processed/sales.parquet.
DATA_MODE=sample
